# ==============================================================================
# Eureka — Enterprise Technology & Workforce Intelligence Platform
# Root Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true
PORT=8000
FRONTEND_PORT=5173

# Active Enterprise Context (Default: Tangentia Global Automation & Digital Transformation)
ACTIVE_ORG_ID=org_tangentia_global
ACTIVE_ORG_NAME="Tangentia Inc."
ACTIVE_ORG_DOMAIN=tangentia.com

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="Eureka Enterprise Intelligence"
VITE_ACTIVE_ORG_ID=org_tangentia_global
VITE_ACTIVE_ORG_NAME="Tangentia"

# Supabase Authentication & PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Google Gemini LLM API (Core Intelligence & RAG Synthesis)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# External Technology Scout & Intelligence Source APIs
GITHUB_TOKEN=your-github-personal-access-token
HUGGINGFACE_API_TOKEN=your-hf-token-here
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=eureka-scout:v1.0.0
# Optional X / Twitter API
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Vector Embeddings & Vector Search (pgvector)
EMBEDDING_PROVIDER=gemini # or openai, local-sentence-transformers
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-004

# Email & Notification Services (Weekly Digest)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=digest@eureka.tangentia.com

# Code Execution Sandbox (Optional - Judge0)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

